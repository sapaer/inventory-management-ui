# Hosted API for local testing (no trailing slash)
VITE_API_URL=https://inventory-management-ivjd.onrender.com

# Pre-launch "Coming soon" gate. Unset = ON in production builds, OFF in `npm run dev`.
# Every route shows Coming Soon unless the browser was unlocked via /team.
# At launch set VITE_COMING_SOON=false in Vercel (Production) and redeploy; set it to true locally to preview.
# VITE_COMING_SOON=true
# Optional: require /team?key=<this> to unlock (visible in the bundle — the real lock is the backend LAUNCH_ALLOWLIST).
VITE_TEAM_KEY=
